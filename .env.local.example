# =============================================================================
# DATABASE (Required)
# =============================================================================
# Neon PostgreSQL connection string (use pooled connection from Neon dashboard)
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# =============================================================================
# AUTHENTICATION (Required)
# =============================================================================
# Secret key for signing JWT tokens (generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=""

# Public email address for password reset requests (displayed in auth modal)
NEXT_PUBLIC_SUPPORT_EMAIL="support@example.com"

# =============================================================================
# OPENAI (Required)
# =============================================================================
# OpenAI API key
OPENAI_API_KEY=""

# OpenAI Assistant ID (from OpenAI dashboard)
ASSISTANT_ID=""

# =============================================================================
# CLOUDFLARE TURNSTILE (Optional - Bot protection)
# =============================================================================
# Turnstile site key (public)
NEXT_PUBLIC_TURNSTILE_SITE_KEY=""

# Turnstile secret key (private)
TURNSTILE_SECRET_KEY=""

# =============================================================================
# EXAM PERIOD GATING (Optional)
# =============================================================================
# If set, app will show exam page until this date (format: YYYY-MM-DD)
EXAM_DATE=""
